<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuración de logs: consola estándar de Spring Boot + archivo dedicado de auditoría de seguridad. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty scope="context" name="LOG_DIR" source="seguridad.auditoria.directorio" defaultValue="logs"/>

    <!-- Monitoreo de actividad sospechosa: logs/seguridad.log, rotación diaria, 30 días de retención -->
    <appender name="SEGURIDAD_ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/seguridad.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/seguridad.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="SEGURIDAD" level="INFO" additivity="true">
        <appender-ref ref="SEGURIDAD_ARCHIVO"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
