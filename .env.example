# Copie este archivo como .env (excluido de git) y complete los valores.
# Spring Boot lo carga automáticamente (spring.config.import=optional:file:.env[.properties]).

# Base de datos MySQL
DB_URL=jdbc:mysql://localhost:3306/petsalud_db?sslMode=PREFERRED&serverTimezone=UTC
DB_USERNAME=petsalud_app
DB_PASSWORD=cambie-esta-clave

# Secreto JWT: Base64 de al menos 32 bytes (256 bits). Generar con:  openssl rand -base64 48   (o: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(48)).decode())")
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=petsalud-backend

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Perfil: dev (carga usuarios de demostración) | prod
SPRING_PROFILES_ACTIVE=dev
# Contraseña de los usuarios de demostración (solo perfil dev). Si se deja vacía se genera una aleatoria y se muestra en consola.
DEMO_PASSWORD=PetSalud#2026
